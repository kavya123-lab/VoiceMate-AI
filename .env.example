# Copy this file to a new file named .env and fill in your own keys.
# Never upload the real .env file to GitHub.

# ---- Flask ----
# Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ---- Gnani (speech to text and text to speech) ----
GNANI_API_KEY=paste_your_real_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference

# ---- Sarvam (the AI that writes the answers) ----
LLM_API_KEY=paste_your_sarvam_key_here
LLM_API_URL=https://api.sarvam.ai/v1/chat/completions
LLM_MODEL=sarvam-105b-conversations